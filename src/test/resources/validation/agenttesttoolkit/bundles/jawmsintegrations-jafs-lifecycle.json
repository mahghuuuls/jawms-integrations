  "cyc3_jafs_b_zero_readonly": {
    "description": "Native foods clear, no equipment, base regen0. Repeat status without dirty or mana getter between.",
    "stopOnFailure": true,
    "trace": true,
    "result": true,
    "commands": [
      "jafs-probe 0",
      "jafs clear ${operator.name}",
