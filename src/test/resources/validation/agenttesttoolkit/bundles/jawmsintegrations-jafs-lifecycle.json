      "devtool mark JAFS_B_BREAD_READY"
    ]
  },
  "cyc3_jafs_b_stack_ready": {
    "description": "Baseline definitions, limit2 threshold100. Eat carrot then potato, inspect after each.",
    "stopOnFailure": true,
    "trace": true,
