  "cyc3_jafs_b_portal_build": {
    "description": "After meal check: set105 current under110 max; build portal in disposable world.",
    "stopOnFailure": true,
    "trace": true,
    "result": true,
    "commands": [
      "jawms-dev mana set ${operator.name} 105",
      "gamemode creative ${operator.name}",
      "tp ${operator.name} 0 200 0",
      "devtool await chunks -4 -4 8 8 400",
      {
        "command": "fill -4 200 -4 8 207 8 minecraft:air",
        "toleratedFailures": [
          "commands.fill.failed"
        ]
      },
      {
        "command": "fill -4 199 -4 8 199 8 minecraft:stone",
        "toleratedFailures": [
          "commands.fill.failed"
        ]
      },
      "fill 2 199 2 5 203 2 minecraft:obsidian",
      "fill 3 200 2 4 202 2 minecraft:portal 1",
      "tp ${operator.name} 0 200 0",
      "jafs inspect ${operator.name}",
      "jawmsintegrations status ${operator.name}",
      "jawms-dev state ${operator.name}",
      "jawms-dev explain ${operator.name}",
      "devtool mark JAFS_B_NETHER_READY"
    ]
  },
  "cyc3_jafs_b_death_ready": {
    "description": "Native keepFoodsOnDeath is named by launch group; no command runs after kill until respawn.",
    "stopOnFailure": true,
    "trace": true,
    "result": true,
    "commands": [
      "jafs-probe 12000",
