    ]
  },
  "cyc3_jafs_b_replacement_expiry": {
    "description": "Read immediately after beetroot; then wait31s for native expiry, carrot remains.",
    "stopOnFailure": true,
    "trace": true,
    "result": true,
    "commands": [
      {
        "command": "jafs inspect ${operator.name}",
        "delayTicks": 2
      },
      "jawmsintegrations status ${operator.name}",
      "jawms-dev state ${operator.name}",
      "jawms-dev explain ${operator.name}",
      "devtool mark JAFS_B_REPLACEMENT_OBSERVED",
      {
        "command": "jafs inspect ${operator.name}",
        "delayTicks": 620
      },
      "jawmsintegrations status ${operator.name}",
      "jawms-dev state ${operator.name}",
      "jawms-dev explain ${operator.name}",
      "devtool mark JAFS_B_EXPIRY_OBSERVED"
    ]
  },
