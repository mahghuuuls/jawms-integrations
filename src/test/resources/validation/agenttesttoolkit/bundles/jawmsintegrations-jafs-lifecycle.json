{
  "cyc3_jafs_b_setup": {
    "description": "Disposable JAFS-B world only; baseline definitions, limit2, threshold100, regen base0.",
    "stopOnFailure": true,
    "trace": true,
    "result": true,
    "commands": [
      "devtool session start cyc3_jafs_lifecycle",
      "devtool session operator @s",
      "devtool capabilities",
      "devtool mods",
      "devtool environment",
      "jafs-probe 12000",
      "gamerule doMobSpawning false",
      "gamerule doDaylightCycle false",
      "gamerule doWeatherCycle false",
      "gamerule naturalRegeneration false",
      "gamerule randomTickSpeed 0",
      "gamerule keepInventory true",
      "difficulty peaceful",
      "jafs clear ${operator.name}",
      {
        "command": "clear ${operator.name}",
        "toleratedFailures": [
          "commands.clear.failure"
        ]
      },
      "gamemode survival ${operator.name}",
      "jawms-dev mana set ${operator.name} 80",
      "devtool log item_use on",
      "jafs inspect ${operator.name}",
      "jawmsintegrations status ${operator.name}",
      "jawms-dev state ${operator.name}",
      "jawms-dev explain ${operator.name}",
      "devtool mark JAFS_B_BASELINE_READY"
    ]
  },
  "cyc3_jafs_b_all_ready": {
    "description": "Baseline definitions required. Eat apple, inspect native tooltip.",
    "stopOnFailure": true,
    "trace": true,
    "result": true,
    "commands": [
      "jafs-probe 12000",
      "jafs clear ${operator.name}",
      {
        "command": "clear ${operator.name}",
        "toleratedFailures": [
          "commands.clear.failure"
        ]
      },
      "gamemode survival ${operator.name}",
      "give ${operator.name} minecraft:apple 1",
      "devtool mark JAFS_B_APPLE_READY"
    ]
  },
  "cyc3_jafs_b_opposite_ready": {
    "description": "Baseline definitions required. Eat bread; negative resource and positive delay.",
    "stopOnFailure": true,
