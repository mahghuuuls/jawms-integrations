  },
  "cyc3_jafs_b_portal_ready": {
    "description": "Eat carrot before walking through the generated vanilla portal; Creative for safe travel.",
    "stopOnFailure": true,
    "trace": true,
    "result": true,
    "commands": [
      "jafs-probe 12000",
      "jafs clear ${operator.name}",
