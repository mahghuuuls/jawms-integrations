      "gamemode survival ${operator.name}",
      "give ${operator.name} minecraft:carrot 1",
      "give ${operator.name} minecraft:carrot 1",
      "give ${operator.name} minecraft:potato 1",
      "devtool mark JAFS_B_CARROT_READY"
    ]
  },
  "cyc3_jafs_b_replacement_ready": {
    "description": "After carrot refresh, eat beetroot; replaces older potato.30s native expiry.",
    "stopOnFailure": true,
    "trace": true,
    "result": true,
    "commands": [
      "jafs-probe 12000",
      "give ${operator.name} minecraft:beetroot 1",
      "jafs inspect ${operator.name}",
      "jawmsintegrations status ${operator.name}",
