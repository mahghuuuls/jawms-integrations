      "devtool mark JAFS_B_RELOAD_CHECKED"
    ]
  },
  "cyc3_jafs_b_rebuild": {
    "description": "No current mana write; unchanged dirty refresh must not drain/refill.",
    "stopOnFailure": true,
    "trace": true,
    "result": true,
